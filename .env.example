HACCP_ENVIRONMENT=development
HACCP_LOG_LEVEL=INFO
HACCP_DATABASE_URL=postgresql+asyncpg://haccp:haccp@localhost:5432/haccp
HACCP_JWT_SECRET_KEY=change-me-in-production
HACCP_JWT_ALGORITHM=HS256
HACCP_ACCESS_TOKEN_EXPIRE_MINUTES=15
HACCP_REFRESH_TOKEN_EXPIRE_DAYS=30
HACCP_INVITE_TOKEN_EXPIRE_DAYS=7
HACCP_S3_BUCKET_NAME=haccp-attachments
HACCP_AWS_REGION=eu-central-1
# AWS credentials are read from the standard AWS SDK chain, not HACCP_-prefixed
# vars: set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or use an IAM role when
# deploying on AWS compute.
